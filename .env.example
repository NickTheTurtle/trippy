# Optional. Secret server-side Google key. Enable Places API (New) and Routes
# API. Restrict by the production server's public IP. Used for Places Text
# Search, Autocomplete, Place Details, Place Photos, and route timing. Leave
# empty to use keyless OpenStreetMap (Photon) and OSRM fallbacks.
GOOGLE_SERVER_KEY=

# Deprecated compatibility fallback for GOOGLE_SERVER_KEY. Do not add this for
# new deployments. It is still read temporarily so existing production env files
# keep working while they are migrated.
GOOGLE_PLACES_KEY=

# Optional. Public browser Google key. Enable only Maps JavaScript API. Restrict
# by HTTP referrer for the web origin, for example https://trippy.dxu.info/*.
# This value is delivered to the client for the interactive trip map. Leave
# empty to use the Leaflet fallback.
GOOGLE_MAPS_KEY=

# Optional. Set to 1 to forbid this process from calling any paid provider. All
# Google keys above read as unset, place search serves the keyless
# OpenStreetMap (Photon) provider, routing falls back to the straight-line
# estimate, and the FX refresh is skipped. Every automated test harness sets it
# for itself, so a test run cannot bill the account even on a machine that has
# live keys here. Never set it in production.
TRIPPY_OFFLINE_PROVIDERS=

# Optional. Points local and E2E runs at a throwaway SQLite file instead of the
# default product database under data/.
TRIPPY_DB=

# Optional. Lets the Playwright cleanup fixture verify the same throwaway file
# when the API server was started with TRIPPY_DB.
E2E_TRIPPY_DB=

# Optional. Sends the sign-up verification and password-reset links. Adding
# someone to a trip emails nobody. With none of these set, sending is skipped
# and registration completes on the spot, so a fresh clone works with no keys.
# MAIL_FROM's domain must be verified with whichever provider is in use, and SES
# is preferred when both are configured.
MAIL_FROM=

# Amazon SES. Region defaults to us-east-1; AWS_REGION is read as a fallback.
# AWS_SESSION_TOKEN is only needed for temporary STS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SES_REGION=

# Resend, used only when the SES keys above are absent.
RESEND_API_KEY=

# Optional. Where the verification and reset links point. Defaults to the local
# web app on :5174. In production set this to the public web origin, e.g.
# https://trippy.dxu.info, so emailed links are not localhost.
APP_URL=

# Production runtime settings (not needed for local dev).

# Node runtime mode. Set to production on the server. This flips the session
# cookie to Secure, disables dev-only CORS, and skips the demo account seed.
NODE_ENV=

# TCP port the API listens on (loopback only, behind Caddy). Defaults to 5175.
PORT=

# Registrations allowed per client address before exponential backoff applies.
# Defaults to 20, which is deliberately loose for the e2e suite. Set a tighter
# production ceiling here. Throttle state is in-memory and per-process, so this
# resets on every deploy and does not span multiple instances.
TRIPPY_REGISTER_LIMIT=

# Number of reverse proxies in front of the app, used to read the trustworthy
# client IP from X-Forwarded-For by counting from the right. Behind Caddy this
# is 1. Leave empty or 0 for local dev, where the header is ignored entirely so
# a spoofed value cannot set the client IP.
TRIPPY_TRUSTED_PROXIES=

# Per-user allowance for paid provider calls (place search and details, city
# search) before exponential backoff applies. Only cache MISSES count, so
# ordinary searching never notices. Defaults to 60.
TRIPPY_PROVIDER_LIMIT=

# Per-IP allowance for the same paid provider calls, a backstop for a whole NAT
# rather than one account. Defaults to 240.
TRIPPY_PROVIDER_IP_LIMIT=

# Per-user allowance for paid routing (Google Directions) calls before the app
# quietly degrades to the free OSRM/estimate path. Defaults to 300.
TRIPPY_ROUTING_LIMIT=
