{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "*.ts"]
}
