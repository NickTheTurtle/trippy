{
	"name": "trippy",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*",
		"tests-e2e"
	],
	"scripts": {
		"dev:api": "npm run dev -w @trippy/api",
		"dev:web": "npm run dev -w @trippy/web",
		"check": "npm run check --workspaces --if-present",
		"format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\"",
		"format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\"",
		"build": "npm run build --workspaces --if-present",
		"test": "vitest run",
		"test:e2e": "npm run test -w @trippy/e2e",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"playwright-core": "^1.63.0",
		"prettier": "^3.8.2",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"react-native-reanimated": "4.5.1",
		"react-native-worklets": "0.10.4"
	}
}
