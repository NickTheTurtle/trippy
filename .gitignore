# Dependencies
node_modules

# Build output (any workspace)
.svelte-kit/
dist/
build/
.output
.vercel
.netlify
.wrangler

# OS
.DS_Store
Thumbs.db

# Editors
.vs/
.idea/

# Env: never commit real keys. Only the example is tracked.
.env
.env.*
!.env.example
!.env.test

# Local databases, including WAL and shared-memory sidecar files.
# The trailing wildcard also catches timestamped backups (app.db.bak-...),
# which a plain *.db pattern did not match and left exposed on this public repo.
*.db*
# Belt and suspenders: any backup dropped in data/, whatever its suffix.
data/*.bak-*

# Dev server logs (dev-api.log, dev-web.log). The repo is public, so never
# publish local server output.
*.log

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Scratch verification output. The Playwright probe scripts themselves (zz-*.cjs)
# are deliberately NOT ignored: a leftover one shows up as a dirty tree and gets
# cleaned up. Their screenshot output is pure noise, so it is ignored - but only
# at the repo root and only under the zz- prefix, so real image assets elsewhere
# in the tree are still tracked normally.
/zz-*.png

# Playwright output
test-results/
playwright-report/
blob-report/
.tmp/
**/.tmp/